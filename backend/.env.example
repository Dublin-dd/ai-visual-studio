# 图像生成服务（SiliconFlow，OpenAI 兼容接口）
IMAGE_API_BASE_URL=https://api.siliconflow.cn/v1
# 标准档模型（快，约 5 秒）
IMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo
# 精修档模型（质量更高，约 23 秒）
IMAGE_MODEL_HQ=Qwen/Qwen-Image
# 草稿档模型（快、便宜）
IMAGE_MODEL_DRAFT=Tongyi-MAI/Z-Image-Turbo
# 你的 SiliconFlow API Key 填在这里（真实 Key 不要提交到仓库）
IMAGE_API_KEY=
# 单张图价格估算（元），用于成本护栏与日志，以控制台账单为准
IMAGE_COST_PER_IMAGE=0.3
# 全站每日任务数上限（成本护栏）
DAILY_TASK_LIMIT=200

# ===== 语音合成（TTS）=====
# 供应商：siliconflow（CosyVoice2，便宜但音质一般）| minimax（speech-02，音质好）
TTS_PROVIDER=siliconflow

# --- 用 SiliconFlow 时 ---
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex

# --- 用 MiniMax 时（推荐做带货口播）---
# 国内：https://api.minimaxi.com    国际：https://api.minimax.io
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_API_KEY=
MINIMAX_TTS_MODEL=speech-02-hd
# 音色示例：female-shaonv 少女 / female-yujie 御姐 / female-chengshu 成熟女声
#          male-qn-qingse 青涩青年 / male-qn-jingying 精英青年 / presenter_female 女主持
MINIMAX_VOICE_ID=female-chengshu
# 部分账号需要 GroupId，没有就留空
MINIMAX_GROUP_ID=
# 语速：0.9 偏慢 / 1.0 正常 / 1.1 偏快（带货常用 1.05~1.1）
TTS_SPEED=1.0
